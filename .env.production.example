# The server's .env (next to docker-compose.yml; never committed).
# Letters and digits only: it goes into a URL.
DB_PASSWORD=change-me-letters-and-digits
# The site's address (links in e-mails).
APP_URL=https://www.equievents.ch
# The desktop apps' release in the image (docs/architecture/releases.md): the GitHub repository
# and the release's tag (v0.2.0); a new release: the tag here, then docker compose build.
RELEASES_REPO=owner/equievents
RELEASE_TAG=
# A private repository: a token with read-only access to its contents (fine-grained).
GITHUB_TOKEN=
# Swiss Equestrian (docs/architecture/server.md): where events, their updates and the riders and
# horses are downloaded from, and keys checked (production; stage: its test system; none:
# development, keys not checked). Nothing is ever sent to it (« Envoyer »: the simulation).
SE_SERVER=production
# The nightly backup (local time, Europe/Zurich) and how many are kept.
BACKUP_AT=02:30
BACKUP_KEEP=14

# --- E-mail: password-reset links (as Gestion Concours: Mailcow at mail.nenuial.org) ----------
# off: nothing sent (logged); redirect: everything to MAIL_REDIRECT_TO only (a test server);
# send: to the real recipients, once the mailbox exists and the domain's SPF / DKIM / DMARC
# are in place. Port 465: TLS; another port: STARTTLS.
MAIL_MODE=off
MAIL_REDIRECT_TO=
SMTP_HOST=mail.nenuial.org
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@equievents.ch
MAIL_FROM_NAME=EquiEvents
MAIL_REPLY_TO=
